# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard).
#
# The anon key is safe to expose client-side by design — Row Level Security
# policies in the database are what actually protect the data, not secrecy
# of this key. Never put the service_role key or the Arkesel API key here;
# those belong only in Supabase Edge Function secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
